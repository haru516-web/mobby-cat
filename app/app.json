{
  "expo": {
    "name": "にゃこモビー",
    "slug": "mobby-cat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ui/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mobbycat.app",
      "infoPlist": {
        "NSMotionUsageDescription": "その日の歩数に合わせて、出会えるにゃこモビーが変わります。",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/system/android-icon-foreground.png",
        "backgroundImage": "./assets/system/android-icon-background.png",
        "monochromeImage": "./assets/system/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/ui/brand/app-icon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ui/brand/logo-nekomobby.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "にゃこモビーと一緒に写真を撮るためにカメラを使います。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "にゃこモビーと撮った写真を保存するために使います。",
          "savePhotosPermission": "にゃこモビーと撮った写真を写真アプリに保存します。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "その日の天気に合わせて、出会えるにゃこモビーが変わります。おおまかな位置だけを使い、保存はしません。",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-iap",
      "expo-apple-authentication"
    ]
  }
}
