{
  "expo": {
    "name": "猫モビー",
    "slug": "mobby-cat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ui/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mobbycat.app",
      "infoPlist": {
        "NSMotionUsageDescription": "その日の歩数に合わせて、出会える猫モビーが変わります。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ui/brand/logo-nekomobby.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0"
        }
      ]
    ]
  }
}
