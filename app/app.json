{
  "expo": {
    "name": "にゃっコレ",
    "slug": "mobby-cat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ui/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mobbycat.app",
      "infoPlist": {
        "NSMotionUsageDescription": "その日の歩数に合わせて、出会えるにゃこモビーが変わります。",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/system/android-icon-foreground.png",
        "backgroundImage": "./assets/system/android-icon-background.png",
        "monochromeImage": "./assets/system/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/ui/brand/app-icon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ui/brand/logo-nekomobby.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "にゃこモビーと一緒に写真を撮るためにカメラを使います。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "にゃこモビーと撮った写真を保存するために使います。",
          "savePhotosPermission": "にゃこモビーと撮った写真を写真アプリに保存します。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "その日の天気に合わせて、出会えるにゃこモビーが変わります。天気を調べるため、おおまかな位置（約10km）を天気予報サービスに送ります。保存はしません。",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-iap",
      "expo-apple-authentication",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "8a487daa-c2cd-4dde-b738-635988ac9a15"
      }
    },
    "owner": "obana.h"
  }
}
